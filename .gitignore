node_modules/
frontend/dist/
build/bin/
build/windows/installer/tmp/
/plugins/

# Taskfile 缓存 / wails3 生成物
.task/
.wails/
*.syso

# 公开语料 eval 数据（体积大且许可各异，不入库；脚本见 scripts/eval-public-corpus.mjs）
scripts/eval-data/

# local IDE / stray builds
.idea/
/datalens.exe
Thumbs.db
.DS_Store

# AI 助手本地状态：持久记忆与计划文件不入库
.cadt/
.zcode/
.workbuddy/

# 运行中替换 exe 时重命名留下的旧映像
*.running-old*.exe

# 运行中替换 exe 时的临时备份映像（按名字单独忽略，并兜住所有 *.exe~ 变体）
/datalens.exe~
/*.exe~

# Windows 保留设备名误产物（cmd 里 redirect 到 nul 时可能落在仓库根）
/nul
