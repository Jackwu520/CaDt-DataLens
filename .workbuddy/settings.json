{
  "permissions": {
    "deny": [
      "Bash(git checkout:*)",
      "Bash(git checkout)",
      "Bash(git.exe checkout:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Shell|Terminal|RunCommand",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/git-guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
