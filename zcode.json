{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["${ZCODE_PROJECT_DIR}/tools/hooks/git-guard.mjs"],
              "timeoutMs": 15000,
              "statusMessage": "git-guard：检查整文件回退类 git 命令"
            }
          ]
        }
      ]
    }
  }
}
